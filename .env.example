# ==========================================
# Tokento — Environment Variables
# ==========================================
# Copy this file to .env and fill in real values.

# ---- Database ----
DATABASE_URL="postgresql://tokento:tokento_dev@localhost:5432/tokento_dev?schema=public"

# ---- Redis ----
REDIS_URL="redis://localhost:6379"

# ---- API Server ----
PORT=4000
NODE_ENV=development
API_BASE_URL="http://localhost:4000"

# ---- Auth / Stytch ----
# Get these from https://stytch.com/dashboard
STYTCH_PROJECT_ID=""
STYTCH_SECRET=""
STYTCH_ENV="test"   # "test" or "live"

# ---- JWT ----
JWT_SECRET="change-me-in-production-use-a-real-secret"
JWT_EXPIRY="24h"

# ---- HMAC Token Signing ----
# Master key for deriving merchant-scoped HMAC keys
HMAC_MASTER_KEY="change-me-in-production-use-a-real-key-64-chars-minimum"

# ---- Sentry ----
SENTRY_DSN=""

# ---- Honeycomb / OpenTelemetry ----
HONEYCOMB_API_KEY=""
OTEL_SERVICE_NAME="tokento-api"

# ---- MCP Adapter ----
MCP_API_BASE_URL="http://localhost:4000"
MCP_AUTH_TOKEN=""

# ---- Cloudflare Workers (for mcp-adapter) ----
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""

# ---- Sandbox ----
SANDBOX_MODE=true

# ---- Local Dev ----
# Deterministic API key for the seeded sandbox merchant. The dashboard reads
# the same value via NEXT_PUBLIC_TOKENTO_API_KEY. If unset, seed.ts generates a
# random key each run and the dashboard will need to be updated manually.
DEV_FIXED_API_KEY="tk_dev_local_sandbox_key_do_not_use_in_production_0000000000000000"

# ---- Dashboard ----
# Mirrors DEV_FIXED_API_KEY so the dashboard authenticates without manual copy.
NEXT_PUBLIC_TOKENTO_API_KEY="tk_dev_local_sandbox_key_do_not_use_in_production_0000000000000000"
NEXT_PUBLIC_API_URL="http://localhost:4000"
